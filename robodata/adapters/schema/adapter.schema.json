{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robodata.local/schema/adapter-descriptor-v1.json",
  "title": "RoboData Adapter Descriptor v1",
  "description": "One row of `robodata adapters list`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_id",
    "label",
    "source_kind",
    "input_kind",
    "supported_versions",
    "pinned",
    "supports_test_label",
    "description"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "input_kind": {
      "type": "string",
      "enum": ["file", "directory"]
    },
    "supported_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pinned": {
      "type": "boolean"
    },
    "supports_test_label": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inspection_only": {
      "type": "boolean"
    }
  }
}
