# 仅用于本地开发。复制为 backend/.env；不要提交复制后的文件。
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=quicdata-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Access Token 仅存于页面内存；浏览器会话 Cookie 的固定有效期使用该天数。
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_DEFAULT_USER_SEED=true
REGISTRATION_MODE=admin_only

# PostgreSQL 和 Redis 在所有运行环境中都是必需依赖。
DATABASE_URL=postgresql+psycopg://quicdata:quicdata@127.0.0.1:5432/quicdata
REDIS_URL=redis://127.0.0.1:6379/0
SCRATCH_ROOT=../deploy/runtime/scratch
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY_ID=quicstudio
STORAGE_SECRET_ACCESS_KEY=quicstudio-local-secret
OSS_BUCKET_RAW=quicstudio-dev-raw
OSS_BUCKET_PROCESS=quicstudio-dev-process
OSS_BUCKET_EXPORT=quicstudio-dev-export

# 单文件不超过该阈值时经 API 分片上传；更大的文件仅在 cloud 模式下直传 OSS。
IMPORT_MAX_UPLOAD_GB=100
IMPORT_API_UPLOAD_MAX_MB=256
IMPORT_DIRECT_UPLOAD_PART_MB=64
IMPORT_DIRECT_UPLOAD_EXPIRE_HOURS=24
IMPORT_DIRECT_UPLOAD_CONCURRENCY=4
