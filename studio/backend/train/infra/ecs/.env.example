PUBLIC_HOSTNAME=train.quicrobot.xyz
WEB_USERNAME=quictrain-admin
# open | local | bootstrap | oidc — see docs/runbooks/identity-bootstrap.md
# Default local: app /login multi-user. Set secrets/admin_password on ECS.
QUICTRAIN_AUTH_MODE=local
QUICTRAIN_ADMIN_EMAIL=admin@quicrobot.com
QUICTRAIN_SESSION_TTL_HOURS=168
# Optional build-time SPA headers when AUTH_MODE=bootstrap (never commit real values)
NEXT_PUBLIC_AUTH_TOKEN=
NEXT_PUBLIC_QUIC_PROJECT=
NEXT_PUBLIC_QUIC_ACTOR=
QUICTRAIN_POOL_RESOURCE_IDS=
QUICTRAIN_POOL_CAPACITIES=
# OSS mirror of CPFS layout for Quota4090 (ECS) DLC jobs
QUICTRAIN_OSS_CPFS_MIRROR_PREFIX=oss://oss-pai-1183v1b6du4vkucj3h-cn-beijing/quictrain
# Idle stop: default never auto-stop DSW / resource groups; require ≥30m if enabled
QUICTRAIN_AUTO_STOP_IDLE_RESOURCES=false
QUICTRAIN_IDLE_MINUTES_BEFORE_STOP=30
QUICTRAIN_AUTO_STOP_RESOURCE_GROUPS=false
QUICTRAIN_PROTECT_H20_DSW=true
QUICTRAIN_PROTECT_H20_RESOURCE_GROUPS=true
QUICTRAIN_ALLOW_H20_DSW_STOP=false
QUICTRAIN_DEDICATED_DSW_INSTANCE_ID=dsw-n1n8o1usk465z51gam
QUICTRAIN_DEDICATED_DSW_NAME=quic-train-5000
ALIYUN_OSS_BUCKET=
ALIYUN_DLC_WORKSPACE_ID=
ALIYUN_DLC_RESOURCE_ID=
QUICTRAIN_CPFS_DATA_SOURCE_ID=
QUICTRAIN_CPFS_ROOT_URI=
# Optional ops webhook (leave empty until real channel exists)
QUICTRAIN_ALERTS_WEBHOOK_URL=
# Optional pre-built ACR images (default: build locally as quictrain-*:local)
# QUICTRAIN_API_IMAGE=
# QUICTRAIN_SCHEDULER_IMAGE=
# QUICTRAIN_WEB_IMAGE=
# QUICTRAIN_MLFLOW_IMAGE=
