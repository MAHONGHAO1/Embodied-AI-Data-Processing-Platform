QUICTRAIN_ENV=development
# Optional unverified sample catalog, only honored in development/test. Keep off for real data.
QUICTRAIN_SEED_EXAMPLE_DATASETS=0
QUICTRAIN_DATABASE_URL=sqlite:///./quictrain.db
QUICTRAIN_PROVIDER=fake
QUICTRAIN_EMBEDDED_SCHEDULER=1
# Browser Origin must match how you open the Web UI. For LAN access add
# http://<lan-ip>:3000 (and keep localhost/127.0.0.1 for local tabs).
QUICTRAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QUICTRAIN_ARTIFACT_ROOT=./artifacts
# Optional V1.1 CPFS workspace. OSS remains the source catalog/control-manifest store while
# checkpoints, caches, model assets, working files, and training outputs live under this mount.
QUICTRAIN_CPFS_DATA_SOURCE_ID=
# ECS/general quotas (Quota4090) need a VPC BMCPFS dataset + mount target.
# Note: as of 2026-09-03 CreateJob with these still hits ResourceAllocateFailed on
# Quota4090; H20 Lingjun can use QUICTRAIN_CPFS_ROOT_URI directly.
QUICTRAIN_CPFS_VPC_DATA_SOURCE_ID=
QUICTRAIN_CPFS_VPC_MOUNT_TARGET=
# Quota4090 / ECS DLC UserVpc JSON (enables OSS mounts + JobEnqueued without BMCPFS).
# Example:
# QUICTRAIN_DLC_USER_VPC_JSON={"VpcId":"vpc-xxx","SwitchId":"vsw-xxx","SecurityGroupId":"sg-xxx","DefaultRoute":"eth1","ExtendedCIDRs":["192.168.1.0/24"]}
QUICTRAIN_DLC_USER_VPC_JSON=
# Optional: when the ECS instance role lacks paidataset:GetDataset, set explicit AK
# for the control-plane DLC client (compose passes these through).
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
QUICTRAIN_CPFS_ROOT_URI=
QUICTRAIN_CPFS_MOUNT_PATH=/mnt/cpfs
QUICTRAIN_CPFS_WORKSPACE_DIR=quictrain
QUICTRAIN_CPFS_PI05_PRETRAINED_DIR=models/pi05/lerobot-pi05-base
QUICTRAIN_CPFS_BOOTSTRAP_PUSHT_URI=
# Optional admin-bootstrap source after the Google Gemma license has been accepted. This must point
# to an authorized private mirror containing only the official PaliGemma tokenizer files.
QUICTRAIN_PI05_TOKENIZER_SOURCE_URI=
QUICTRAIN_MLFLOW_TRACKING_URI=http://localhost:5001
QUICTRAIN_PUBLIC_MLFLOW_URL=http://localhost:5001

# Identity — multi-user email/password is the default for local + cloud.
# QUICTRAIN_AUTH_MODE=open|local|bootstrap|oidc
# local: /login; production must set QUICTRAIN_ADMIN_PASSWORD (or ECS secret admin_password).
# development + local with empty password seeds QuicTrain-Dev-Local! (local only).
QUICTRAIN_AUTH_MODE=local
QUICTRAIN_BOOTSTRAP_ADMIN_TOKEN=
QUICTRAIN_ADMIN_EMAIL=admin@quicrobot.com
QUICTRAIN_ADMIN_PASSWORD=
QUICTRAIN_SESSION_TTL_HOURS=168
# OIDC reservation (IdP MFA). Set issuer/audience/jwks for production.
QUICTRAIN_OIDC_ISSUER=
QUICTRAIN_OIDC_AUDIENCE=
QUICTRAIN_OIDC_JWKS_URL=
QUICTRAIN_ALERTS_WEBHOOK_URL=
QUICTRAIN_PROVIDER_DISABLED=0

# Aliyun values are only read when QUICTRAIN_PROVIDER=aliyun_dlc.
ALIYUN_REGION_ID=
ALIYUN_DLC_WORKSPACE_ID=
ALIYUN_DLC_RESOURCE_ID=
# Hybrid pools: 4090 Quota4090 / Nv4093 (8 GPU) + H20 default ResourceId from ALIYUN_DLC_RESOURCE_ID
QUICTRAIN_POOL_RESOURCE_IDS=cn-beijing-4090:quota16ktslmgp8r,cn-beijing-h20:quota1lnd98qodrh,cn-beijing-h20-8:quota1lnd98qodrh
QUICTRAIN_POOL_CAPACITIES=cn-beijing-4090:32,cn-beijing-h20:40,cn-beijing-h20-8:40
# Optional when the quota requires a concrete ECS specification. Discover it from the bound quota.
ALIYUN_DLC_ECS_SPEC=
# Leave empty when a dedicated quota already selects the GPU model.
# Set only when DLC requires a provider-specific GPU type code.
ALIYUN_DLC_GPU_TYPE=
ALIYUN_DLC_JOB_MAX_RUNNING_TIME_MINUTES=60
ALIYUN_DLC_PRIORITY=1
ALIYUN_DLC_ACCESSIBILITY=PUBLIC
ALIYUN_DLC_ENDPOINT=pai-dlc.cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_RAM_ROLE_ARN=

# Discovered Beijing production values are documented in docs/V1_CLOUD_ROLLOUT.md. Keep this file
# credential-free; copy IDs into the deployment secret/config system rather than committing .env.
# Production example; use the internal endpoint form accepted by PAI-DLC DataSources.
# QUICTRAIN_ARTIFACT_ROOT=oss://bucket.oss-cn-beijing-internal.aliyuncs.com/quictrain/runs
