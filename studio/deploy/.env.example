# Copy to deploy/.env before production deployment. This file contains non-sensitive configuration only.
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DOCKER_REGISTRY_PREFIX=docker.m.daocloud.io/library
APT_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY_URL=https://registry.npmmirror.com

CORS_ORIGINS=https://quicdata.example.com
API_BIND_HOST=127.0.0.1
API_PORT=8000
# Production must keep this true. UAT uses deploy/uat/.env with false only
# when its isolated browser endpoint is intentionally HTTP.
SESSION_COOKIE_SECURE=true
HSTS_ENABLED=true
# Image tags are automatically generated by make prod-up and scripts/uat-up.sh based on the current Git checkout.
UAT_AI_WORKER_ENABLED=false
WEB_CONCURRENCY=1

# Container memory limit per Celery worker. memory and memory+swap are identical to prevent failing tasks from exhausting host swap.
WORKER_MEMORY_LIMIT=12g

# Worker concurrency corresponds to database JobRun slot counts. Media defaults to concurrency 4; other long-running tasks remain conservative.
CONTROL_WORKER_CONCURRENCY=1
INGEST_WORKER_CONCURRENCY=2
MEDIA_WORKER_CONCURRENCY=4
PUBLISH_WORKER_CONCURRENCY=1
EXPORT_WORKER_CONCURRENCY=1
ANALYTICS_WORKER_CONCURRENCY=1
GOVERNANCE_WORKER_CONCURRENCY=1

# Subprocesses recycled by task count or resident memory, in tasks and KiB respectively.
CONTROL_MAX_TASKS_PER_CHILD=500
CONTROL_MAX_MEMORY_PER_CHILD_KB=524288
INGEST_MAX_TASKS_PER_CHILD=20
INGEST_MAX_MEMORY_PER_CHILD_KB=2097152
MEDIA_MAX_TASKS_PER_CHILD=10
MEDIA_MAX_MEMORY_PER_CHILD_KB=3145728
PUBLISH_MAX_TASKS_PER_CHILD=10
PUBLISH_MAX_MEMORY_PER_CHILD_KB=4194304
EXPORT_MAX_TASKS_PER_CHILD=5
EXPORT_MAX_MEMORY_PER_CHILD_KB=4194304
ANALYTICS_MAX_TASKS_PER_CHILD=100
ANALYTICS_MAX_MEMORY_PER_CHILD_KB=1048576
GOVERNANCE_MAX_TASKS_PER_CHILD=50
GOVERNANCE_MAX_MEMORY_PER_CHILD_KB=1048576

CONTROL_WORKER_MEMORY_LIMIT=2g
EXPORT_WORKER_MEMORY_LIMIT=8g
ANALYTICS_WORKER_MEMORY_LIMIT=2g
GOVERNANCE_WORKER_MEMORY_LIMIT=2g

# Three logical buckets. Production endpoint/provider must be the same accessible object storage;
# Credentials must only reside in deploy/secrets/storage_access_key_id and
# deploy/secrets/storage_secret_access_key, never in this file.
STORAGE_PROVIDER=aliyun
STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_RAW=quicstudio-prod-raw
OSS_BUCKET_PROCESS=quicstudio-prod-process
OSS_BUCKET_EXPORT=quicstudio-prod-export

# Formal publication reuses local host cache for immutable raw QRDF. Cache can safely be rebuilt and should not store credentials or unique data copies.
PUBLICATION_SOURCE_CACHE_TTL_SECONDS=86400
PUBLICATION_SOURCE_CACHE_MAX_BYTES=21474836480

# Browser-to-Batch single file total limit. Small files upload via API; large files upload directly to OSS.
IMPORT_MAX_UPLOAD_GB=100
IMPORT_API_UPLOAD_MAX_MB=256
IMPORT_DIRECT_UPLOAD_PART_MB=64
IMPORT_DIRECT_UPLOAD_EXPIRE_HOURS=24
IMPORT_DIRECT_UPLOAD_CONCURRENCY=4

# Runtime state records cleaned up hourly in batches; security audit logs retained permanently by default and unaffected.
RUNTIME_REALTIME_EVENT_RETENTION_DAYS=7
RUNTIME_JOB_RETENTION_DAYS=30
RUNTIME_IMPORT_SESSION_RETENTION_DAYS=30
RUNTIME_RETENTION_BATCH_SIZE=500

# Native LeRobot default delivery directory in OSS_BUCKET_EXPORT; ZIP generated on-demand and pruned strictly per record.
NATIVE_LEROBOT_BUNDLE_MAX_GB=100
NATIVE_LEROBOT_BUNDLE_RETENTION_DAYS=7

# Production API does not run outbox background loop; consumed by single realtime-dispatcher service.
REALTIME_DISPATCHER_IN_API=false
REALTIME_DISPATCH_INTERVAL_SECONDS=5
CELERY_INSPECT_CACHE_SECONDS=5

# Browser direct read and raw multipart write only sign server-determined exact objects; must use the same public HTTPS endpoint.
# CORS_ORIGINS only lists trusted frontend origins; do not enter OSS Endpoint, and do not use wildcards.
OSS_BROWSER_DIRECT_ENABLED=true
OSS_BROWSER_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_BROWSER_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BROWSER_URL_TTL_SECONDS=900

# Allow same-region OSS UploadPartCopy for source package data.mcap exceeding 1 GiB.
# Enable only after source/target permissions and target bucket versioning policies are verified.
SOURCE_OSS_MULTIPART_COPY_ENABLED=
# Legacy EGO config serves as backwards-compatible fallback if above general config is empty.
EGO_SOURCE_OSS_MULTIPART_COPY_ENABLED=false
