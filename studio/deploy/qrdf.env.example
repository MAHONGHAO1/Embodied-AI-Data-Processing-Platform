# QRDF SDK fetch configuration (copy to deploy/qrdf.env or export in environment)
#
# Read by scripts/fetch-qrdf.sh during deploy / setup.
# If backend/vendor/qrdf/ already contains a complete SDK (including qrdf/__init__.py + pyproject.toml),
# remote fetch is skipped by default; set QRDF_FORCE_FETCH=1 to force update.

# Git repository URL
QRDF_GIT_URL=git@codeup.aliyun.com:6a3ce6c6a6fcee143fa25a90/QuicData/qrdf.git

# Branch / tag / commit (defaults to tracking develop)
QRDF_GIT_REF=develop

# Shallow clone depth (0 = full clone)
QRDF_GIT_DEPTH=1

# Force fetch/update from remote (1 = force; 0 or empty = skip if full vendor exists)
QRDF_FORCE_FETCH=0

# Local development path (syncs from local directory and skips Git remote if set)
# QRDF_LOCAL_PATH=../qrdf
