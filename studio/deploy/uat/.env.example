# UAT is production-like and uses Aliyun OSS, but intentionally allows HTTP
# for an isolated test endpoint. Keep this file separate from deploy/.env.
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DOCKER_REGISTRY_PREFIX=docker.m.daocloud.io/library
APT_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY_URL=https://registry.npmmirror.com

ENVIRONMENT=production
SESSION_COOKIE_SECURE=false
HSTS_ENABLED=false
CORS_ORIGINS=http://uat.example.com:18080
API_BIND_HOST=127.0.0.1
API_PORT=18080

# These paths are interpreted relative to deploy/docker-compose.prod.yml.
DEPLOY_RUNTIME_DIR=./uat/runtime
DEPLOY_SECRETS_DIR=./uat/secrets

WEB_CONCURRENCY=1
UAT_AI_WORKER_ENABLED=false
REALTIME_DISPATCHER_IN_API=false
REALTIME_DISPATCH_INTERVAL_SECONDS=5
CELERY_INSPECT_CACHE_SECONDS=5

STORAGE_PROVIDER=aliyun
STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_RAW=quicstudio-uat-raw
OSS_BUCKET_PROCESS=quicstudio-uat-process
OSS_BUCKET_EXPORT=quicstudio-uat-export

OSS_BROWSER_DIRECT_ENABLED=true
OSS_BROWSER_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_BROWSER_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BROWSER_URL_TTL_SECONDS=900

IMPORT_MAX_UPLOAD_GB=100
IMPORT_API_UPLOAD_MAX_MB=256
IMPORT_DIRECT_UPLOAD_PART_MB=64
IMPORT_DIRECT_UPLOAD_EXPIRE_HOURS=24
IMPORT_DIRECT_UPLOAD_CONCURRENCY=4

RUNTIME_REALTIME_EVENT_RETENTION_DAYS=7
RUNTIME_JOB_RETENTION_DAYS=30
RUNTIME_IMPORT_SESSION_RETENTION_DAYS=30
RUNTIME_RETENTION_BATCH_SIZE=500
NATIVE_LEROBOT_BUNDLE_MAX_GB=100
NATIVE_LEROBOT_BUNDLE_RETENTION_DAYS=7

SOURCE_OSS_MULTIPART_COPY_ENABLED=
EGO_SOURCE_OSS_MULTIPART_COPY_ENABLED=false
